# ============================================================
# EKOMAT Dashboard v2 — переменные окружения
# Скопируй в .env (локально) или задай в Railway → Variables.
# .env в гит не попадает, см. .gitignore
# ============================================================

# ─── База данных ───────────────────────────────────────────
# ВАЖНО: у v2 своя база. Никогда не указывай сюда прод.
DATABASE_URL=postgresql://user:pass@host:5432/ekomat_v2

# ─── Режим инстанса ────────────────────────────────────────
# SYNC_ENABLED=false — планировщик не стартует, ручной синк отвечает 503,
# исходящие HTTP-запросы блокируются на уровне сокета.
#
# ДЛЯ v2 ВСЕГДА false, пока прод живой.
# Причина: Allegro ротирует refresh_token при каждом обращении. Два инстанса
# с одним токеном инвалидируют токены друг друга, и прод теряет Allegro.
SYNC_ENABLED=false

# Приём вебхуков. По умолчанию повторяет SYNC_ENABLED.
WEBHOOKS_ENABLED=false

# Подпись в интерфейсе, чтобы визуально не спутать копию с продом.
INSTANCE_NAME=v2 / staging

# Идентификатор инстанса. Им префиксуются ключи секретов в app_settings:
#   prod — старые ключи без префикса (боевой инстанс, ничего не меняется);
#   любое другое значение — свои ключи, боевые токены из клона базы не видны.
# Если не задать: SYNC_ENABLED=true -> prod, SYNC_ENABLED=false -> v2.
# НА ПРОДЕ ЭТУ ПЕРЕМЕННУЮ ЗАДАВАТЬ НЕ НУЖНО.
INSTANCE_ID=v2

# ─── Первый вход ───────────────────────────────────────────
# Создаётся только если таблица users пуста (на клоне прода — не создастся).
OWNER_EMAIL=admin@ekomat.pl
OWNER_PASSWORD=          # пусто → сгенерируется случайный и выведется в лог
OWNER_NAME=Admin

# ─── Сессии и cookie ───────────────────────────────────────
SESSION_TTL_DAYS=30
COOKIE_SECURE=true       # false только для локального http://
COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# ─── CORS ──────────────────────────────────────────────────
# Пусто = только свой домен. Домены через запятую.
CORS_ORIGINS=

# ============================================================
# Ниже — интеграции. При SYNC_ENABLED=false не используются.
# НЕ ЗАПОЛНЯЙ их в v2, пока синк выключен: пустые значения —
# дополнительная страховка от случайного обращения к проду.
# ============================================================

# ─── WooCommerce (dobraszklarnia.pl) ───────────────────────
WOO_URL=https://dobraszklarnia.pl
WOO_KEY=
WOO_SECRET=
WOO_WEBHOOK_SECRET=

# ─── PrestaShop ────────────────────────────────────────────
PRESTA_OTEKO_URL=https://oteko.pl
PRESTA_OTEKO_KEY=
PRESTA_CIEP_URL=https://cieplarnia.pl
PRESTA_CIEP_KEY=

# ─── Allegro, аккаунт 1 ────────────────────────────────────
# ОСОБО ОПАСНО для v2: refresh_token одноразовый и ротируется.
# Если когда-нибудь понадобится живой Allegro в v2 — не копируй боевые
# ключи, а зарегистрируй ОТДЕЛЬНОЕ приложение в Allegro Developer Portal.
# У него будет свой client_id и свой цикл токенов, не связанный с продом.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REFRESH_TOKEN=
ALLEGRO_SELLER_NAME=

# ─── Allegro, аккаунт 2 (до ALLEGRO10_*) ───────────────────
ALLEGRO2_CLIENT_ID=
ALLEGRO2_CLIENT_SECRET=
ALLEGRO2_REFRESH_TOKEN=
ALLEGRO2_SELLER_NAME=

# ─── MCP сервер ────────────────────────────────────────────
EKOMAT_API_KEY=
